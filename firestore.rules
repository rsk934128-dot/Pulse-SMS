rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-+]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 320)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidCloudMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.threadAddress is string && data.threadAddress.size() <= 100 &&
             data.senderAddress is string && data.senderAddress.size() <= 100 &&
             data.recipientAddress is string && data.recipientAddress.size() <= 100 &&
             data.body is string && data.body.size() <= 5000 &&
             data.isIncoming is bool &&
             (data.category in ['PERSONAL', 'OTP', 'TRANSACTION', 'PROMOTION', 'SPAM', 'TRAVEL']) &&
             data.createdAt is timestamp;
    }

    function isValidCloudConversation(data) {
      return data.address is string && data.address.size() <= 100 &&
             (!('contactName' in data) || data.contactName == null || (data.contactName is string && data.contactName.size() <= 100)) &&
             data.snippet is string && data.snippet.size() <= 1000 &&
             data.category is string && data.category.size() <= 50 &&
             data.unreadCount is int && data.unreadCount >= 0 &&
             data.isPinned is bool &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidCloudNotification(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 2000 &&
             data.appName is string && data.appName.size() > 0 && data.appName.size() <= 100 &&
             data.packageName is string && data.packageName.size() > 0 && data.packageName.size() <= 200 &&
             data.sourceDevice in ['MOBILE', 'WEB'] &&
             data.category in ['SMS', 'APP', 'OTP', 'WEB_ALERT', 'TEST'] &&
             data.isTest is bool &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'displayName', 'email']) &&
                       request.resource.data.keys().hasOnly(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(request.resource.data);

      allow update: if isOwner(userId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt', 'createdAt']) &&
                       isValidUserProfile(request.resource.data);

      allow delete: if isOwner(userId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
                         isValidId(messageId) &&
                         request.resource.data.id == messageId &&
                         request.resource.data.keys().hasAll(['id', 'threadAddress', 'senderAddress', 'recipientAddress', 'body', 'isIncoming', 'category', 'createdAt']) &&
                         request.resource.data.keys().hasOnly(['id', 'threadAddress', 'senderAddress', 'recipientAddress', 'body', 'isIncoming', 'category', 'createdAt']) &&
                         isValidCloudMessage(request.resource.data);

        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         request.resource.data.keys().hasAll(['address', 'snippet', 'category', 'unreadCount', 'isPinned', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['address', 'contactName', 'snippet', 'category', 'unreadCount', 'isPinned', 'createdAt', 'updatedAt']) &&
                         isValidCloudConversation(request.resource.data);

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         request.resource.data.address == resource.data.address &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactName', 'snippet', 'category', 'unreadCount', 'isPinned', 'updatedAt']) &&
                         isValidCloudConversation(request.resource.data);

        allow delete: if isOwner(userId) && isValidId(conversationId);
      }
    }

    match /pairing_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if false;

      allow create: if isValidId(sessionId) &&
                       request.resource.data.sessionId == sessionId &&
                       request.resource.data.status in ['PENDING', 'CONNECTED'];

      allow update: if isValidId(sessionId) &&
                       request.resource.data.status in ['PENDING', 'CONNECTED', 'DISCONNECTED'];

      allow delete: if isValidId(sessionId);

      match /messages/{messageId} {
        allow get: if isValidId(sessionId) && isValidId(messageId);
        allow list: if isValidId(sessionId);

        allow create, update: if isValidId(sessionId) &&
                         isValidId(messageId) &&
                         request.resource.data.id == messageId &&
                         request.resource.data.keys().hasAll(['id', 'threadAddress', 'senderAddress', 'recipientAddress', 'body', 'isIncoming', 'category', 'createdAt']) &&
                         request.resource.data.keys().hasOnly(['id', 'threadAddress', 'senderAddress', 'recipientAddress', 'body', 'isIncoming', 'category', 'createdAt']) &&
                         isValidCloudMessage(request.resource.data);

        allow delete: if isValidId(sessionId) && isValidId(messageId);
      }

      match /outgoing_requests/{requestId} {
        allow get: if isValidId(sessionId) && isValidId(requestId);
        allow list: if isValidId(sessionId);

        allow create: if isValidId(sessionId) &&
                         isValidId(requestId) &&
                         request.resource.data.id == requestId &&
                         request.resource.data.keys().hasAll(['id', 'recipient', 'body', 'status', 'createdAt']) &&
                         request.resource.data.keys().hasOnly(['id', 'recipient', 'body', 'status', 'createdAt']) &&
                         request.resource.data.recipient is string &&
                         request.resource.data.recipient.size() > 0 &&
                         request.resource.data.recipient.size() <= 100 &&
                         request.resource.data.body is string &&
                         request.resource.data.body.size() > 0 &&
                         request.resource.data.body.size() <= 2000 &&
                         request.resource.data.status == 'PENDING' &&
                         request.resource.data.createdAt is timestamp;

        allow update: if isValidId(sessionId) &&
                         isValidId(requestId) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                         request.resource.data.status in ['PENDING', 'SENT', 'FAILED'];

        allow delete: if isValidId(sessionId) && isValidId(requestId);
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(sessionId) && isValidId(notificationId);
        allow list: if isValidId(sessionId);

        allow create, update: if isValidId(sessionId) &&
                         isValidId(notificationId) &&
                         request.resource.data.id == notificationId &&
                         request.resource.data.keys().hasAll(['id', 'title', 'body', 'appName', 'packageName', 'sourceDevice', 'category', 'isTest', 'createdAt']) &&
                         request.resource.data.keys().hasOnly(['id', 'title', 'body', 'appName', 'packageName', 'sourceDevice', 'category', 'isTest', 'createdAt']) &&
                         isValidCloudNotification(request.resource.data);

        allow delete: if isValidId(sessionId) && isValidId(notificationId);
      }
    }
  }
}
