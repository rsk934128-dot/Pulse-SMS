{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for Pulse SMS sync",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID from Firebase Auth"
        },
        "displayName": {
          "type": "string",
          "description": "Display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "CloudMessage": {
      "title": "CloudMessage",
      "description": "Synchronized SMS message record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID matching message UUID"
        },
        "threadAddress": {
          "type": "string",
          "description": "Thread phone number or sender ID"
        },
        "senderAddress": {
          "type": "string",
          "description": "Message sender address"
        },
        "recipientAddress": {
          "type": "string",
          "description": "Message recipient address"
        },
        "body": {
          "type": "string",
          "description": "SMS message text body"
        },
        "isIncoming": {
          "type": "boolean",
          "description": "True if incoming, false if sent"
        },
        "category": {
          "type": "string",
          "enum": ["PERSONAL", "OTP", "TRANSACTION", "PROMOTION", "SPAM"],
          "description": "Categorization tag"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        }
      },
      "required": ["id", "threadAddress", "senderAddress", "recipientAddress", "body", "isIncoming", "category", "createdAt"]
    },
    "CloudConversation": {
      "title": "CloudConversation",
      "description": "Synchronized conversation summary",
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "description": "Target address or sender id"
        },
        "contactName": {
          "type": "string",
          "description": "Resolved contact name"
        },
        "snippet": {
          "type": "string",
          "description": "Last message snippet"
        },
        "category": {
          "type": "string",
          "description": "Conversation category tag"
        },
        "unreadCount": {
          "type": "integer",
          "description": "Number of unread messages"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether conversation is pinned to top"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["address", "snippet", "category", "unreadCount", "isPinned", "createdAt", "updatedAt"]
    },
    "CloudNotification": {
      "title": "CloudNotification",
      "description": "Two-way mirrored notification across paired Mobile and Web devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "appName": { "type": "string" },
        "packageName": { "type": "string" },
        "sourceDevice": { "type": "string", "enum": ["MOBILE", "WEB"] },
        "category": { "type": "string", "enum": ["SMS", "APP", "OTP", "WEB_ALERT", "TEST"] },
        "isTest": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "appName", "packageName", "sourceDevice", "category", "isTest", "createdAt"]
    },
    "RemoteCameraState": {
      "title": "RemoteCameraState",
      "description": "Real-time remote camera command & live JPEG frame bridge between Website and Mobile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string", "enum": ["NONE", "START_BACK", "START_FRONT", "STOP", "CAPTURE_HD", "TOGGLE_TORCH"] },
        "commandSeq": { "type": "integer" },
        "status": { "type": "string", "enum": ["IDLE", "STARTING", "ACTIVE", "STOPPED", "PERMISSION_NEEDED", "ERROR"] },
        "lens": { "type": "string", "enum": ["BACK", "FRONT"] },
        "torchOn": { "type": "boolean" },
        "frameBase64": { "type": "string" },
        "hdFrameBase64": { "type": "string" },
        "frameSeq": { "type": "integer" },
        "hdSeq": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "deviceName": { "type": "string" },
        "errorMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    },
    "CloudCallLog": {
      "title": "CloudCallLog",
      "description": "Synchronized phone call history entry visible on paired Website",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "contactName": { "type": "string" },
        "callType": { "type": "string", "enum": ["INCOMING", "OUTGOING", "MISSED", "REJECTED", "BLOCKED", "VOICEMAIL", "UNKNOWN"] },
        "durationSec": { "type": "integer" },
        "simLabel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "number", "callType", "durationSec", "createdAt"]
    },
    "RemoteMicrophoneState": {
      "title": "RemoteMicrophoneState",
      "description": "Real-time remote microphone command & live PCM-16 Base64 audio bridge between Website and Mobile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string", "enum": ["NONE", "START", "STOP"] },
        "commandSeq": { "type": "integer" },
        "status": { "type": "string", "enum": ["IDLE", "STARTING", "ACTIVE", "STOPPED", "PERMISSION_NEEDED", "ERROR"] },
        "audioBase64": { "type": "string" },
        "chunkSeq": { "type": "integer" },
        "sampleRate": { "type": "integer" },
        "audioLevel": { "type": "integer" },
        "deviceName": { "type": "string" },
        "errorMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    },
    "CloudCallRecording": {
      "title": "CloudCallRecording",
      "description": "Recorded call audio mapped to a phone number and optional device location coordinates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "contactName": { "type": "string" },
        "callType": { "type": "string", "enum": ["INCOMING", "OUTGOING", "MANUAL", "UNKNOWN"] },
        "durationSec": { "type": "integer" },
        "audioBase64": { "type": "string" },
        "mimeType": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "locationLabel": { "type": "string" },
        "deviceName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "phoneNumber", "callType", "durationSec", "audioBase64", "mimeType", "createdAt"]
    },
    "RemoteCallRecorderState": {
      "title": "RemoteCallRecorderState",
      "description": "Real-time call recorder command & status bridge between Website and Mobile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string", "enum": ["NONE", "START", "STOP"] },
        "commandSeq": { "type": "integer" },
        "targetNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["IDLE", "STARTING", "RECORDING", "UPLOADING", "SAVED", "STOPPED", "PERMISSION_NEEDED", "ERROR"] },
        "durationSec": { "type": "integer" },
        "deviceName": { "type": "string" },
        "errorMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile document"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/CloudMessage"
      },
      "description": "User's synchronized SMS message collection"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/CloudConversation"
      },
      "description": "User's synchronized conversations list"
    },
    "/pairing_sessions/{sessionId}/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/CloudNotification"
      },
      "description": "Real-time two-way mirrored notifications between paired Mobile and Web"
    },
    "/pairing_sessions/{sessionId}/camera/{cameraDocId}": {
      "schema": {
        "$ref": "#/entities/RemoteCameraState"
      },
      "description": "Real-time remote mobile camera control and live frame stream for paired Website"
    },
    "/pairing_sessions/{sessionId}/call_logs/{callId}": {
      "schema": {
        "$ref": "#/entities/CloudCallLog"
      },
      "description": "Synchronized mobile call log history for paired Website"
    },
    "/pairing_sessions/{sessionId}/microphone/{micDocId}": {
      "schema": {
        "$ref": "#/entities/RemoteMicrophoneState"
      },
      "description": "Real-time remote mobile microphone control and live audio stream for paired Website"
    },
    "/pairing_sessions/{sessionId}/call_recordings/{recordingId}": {
      "schema": {
        "$ref": "#/entities/CloudCallRecording"
      },
      "description": "Recorded call audio entries mapped with phone numbers and GPS coordinates for paired Website"
    },
    "/pairing_sessions/{sessionId}/call_recorder/{recDocId}": {
      "schema": {
        "$ref": "#/entities/RemoteCallRecorderState"
      },
      "description": "Remote call recorder control and live recording state between Website and Mobile"
    }
  }
}
